QLabel {
  color: #FFFFFF;
  font-family: 'Poppins', sans-serif;
}
            
#btnMin, #btnWid, #btnClose, #btnMenu {
  background-color: #070C27;
  color: #ACABAB;
  border: none;
}

#btnMenu {
  border-radius: 8px;
}
            
#btnMin:hover, #btnWid:hover, #btnMenu:hover {
  background-color: #b4befe;
}

#btnClose:hover {
  background-color: #b53836;
}
            
/* Efeito ao clicar no botão */
#btnMin:pressed, #btnWid:pressed, #btnClose:pressed {
  background-color: #74c7ec;
}

#barraTitulo {
  background-color: #070C27;
}

#conteudo {
  background-color: #222538;
}

#btnMin {
  padding-bottom: 10px;
}

#titulo {
  font-size: 24px;
}

#conteudo QLabel {
  color: #ACABAB;
}

#linha {
  background-color: #D9D9D9;
}

#labelTitulo {
  font-size: 58px;
  margin-bottom: 2px;
}

#labelTexto {
  font-size: 22px;
  margin-top: 11px;
  margin-bottom: 150px;
}

#btnUpload {
  background-color: transparent;
  border: 3px solid #ACABAB;
  border-radius: 20px;
}

#btnUpload:hover {
  border-color: #636262;
}

#sidebar {
  background-color: #801A1C2A;
}

#btnConfig, #btnHistory {
  text-align: left;
  background-color: transparent;
  color: #FFFFFF;
  font-family: 'Poppins', sans-serif;
  font-size: 14px;
}

#btnConfig:hover, #btnHistory:hover {
  color: #8C8A8A;
}

#btnCloseSidebar {
  background-color: transparent;
  border-radius: 20px;
  border: none;
}

#btnCloseSidebar:hover {
  background-color: #338C8A8A;
}

#menuRow {
  background-color: #807E7E7E;
}