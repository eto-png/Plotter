/*Estilos globais*/
QLabel {
  font-family: 'Poppins', sans-serif;
}

/*Estilos da barra de titulo*/
#titulo {
  color: #FFFFFF;
  font-size: 22px;
  margin-left: 12px;
}
            
#btnMin, #btnWid, #btnClose, #btnMenu {
  background-color: transparent;
  color: #ACABAB;
  border: none;
}

#btnMenu {
  border-radius: 8px;
  background-color: #070C27;
}
            
#btnMin:hover, #btnWid:hover, #btnMenu:hover {
  background-color: #b4befe;
}

#btnClose:hover {
  background-color: #b53836;
}

#btnMin:pressed, #btnWid:pressed, #btnClose:pressed {
  background-color: #74c7ec;
}

#barraTitulo {
  background-color: #070C27;
}

#btnMin {
  padding-bottom: 10px;
}

/*Estilos da sidebar*/
#scroll, #scroll_content {
  background-color: transparent;
}

#sidebar QScrollBar:vertical { /*Fundo do scroll*/
    border: none;
    background: transparent;
    width: 6px;
    margin: 2px 0px 2px 0px;
}

#sidebar QScrollBar::handle:vertical { /*Parte arrastável*/
    background-color: #66969696; /*40% de opacidade (66 da frente)*/
    min-height: 25px;
    border-radius: 3px;
}

#sidebar QScrollBar::handle:vertical:hover {
    background-color: #99969696; /*60% de opacidade (99 da frente)*/
}

#sidebar QScrollBar::add-line:vertical, #sidebar QScrollBar::sub-line:vertical {
    /*Esconde as setinhas de cime e de baixo*/
    height: 0px;
    background: none;
    border: none;
}

#sidebar QScrollBar::add-page:vertical, #sidebar QScrollBar::sub-page:vertical {
    /*Remove o fundo quadriculado do handle*/
    background: none;
}

#btnConfig, #sbOptTitle, #btnDashItem, #btnPDF, #btnJPG {
  text-align: left;
  background-color: transparent;
  font-family: 'Poppins', sans-serif;
  font-size: 14px;
}

#btnNewDash {
  background-color: transparent;
  font-family: 'Poppins', sans-serif;
  font-size: 14px;
}

#btnCloseSidebar {
  border-radius: 20px;
  border: none;
}

#btnCloseSidebar:hover {
  background-color: #338C8A8A;
}

#aiContainer {
  border-radius: 19px;
}

#inputAI {
  background-color: #ACABAB;
  padding: 3 0 3 5;
  border-top-left-radius: 10px;
  border-bottom-left-radius: 10px;
  font-family: 'Poppins', sans-serif;
  font-size: 13px;
}

#btnSendAI {
  background-color: #ACABAB;
  border: none;
  border-top-right-radius: 10px;
  border-bottom-right-radius: 10px;
  qproperty-icon: url("assets/images/send.svg");
  qproperty-iconSize: 18px 18px;
}

/*Estilos da home*/
#labelTitulo {
  font-size: 58px;
  margin-bottom: 2px;
}

#labelTexto {
  font-size: 22px;
  margin-top: 11px;
  margin-bottom: 150px;
}

#btnUpload {
  border-radius: 20px;
}

/*Estilo do settings*/
#settingsTitle {
  font-size: 24px;
  padding: 6px 0 6px 0;
}

Window[mode="maximized"] #settingsTitle {
  font-size: 28px;
}

#cardTitle {
  font-size: 14px;
}

Window[mode="maximized"] #cardTitle {
  font-size: 16px;
}

#cardDesc {
  font-weight: bold;
  font-size:14px;
}

Window[mode="maximized"] #cardDesc {
  font-size: 16px;
}

#btnDark, #btnLight, #btnSystem {
  padding: 6px;
  font-size: 12px;
  border-radius: 4px;
}

Window[mode="maximized"] #btnDark, Window[mode="maximized"] #btnLight, Window[mode="maximized"] #btnSystem {
  border-radius: 5px;
  font-size: 16px;
  padding: 8px;
}

#btnFast, #btnStandard, #btnDetailed {
  font-size: 12px;
  padding: 6px 0px 6px 0px;
  background-color: transparent;
}

#btnFast {
  border-top-left-radius: 12px;
  border-bottom-left-radius: 12px;
}

#btnDetailed {
  border-top-right-radius: 12px;
  border-bottom-right-radius: 12px;
}

Window[mode="maximized"] #btnFast, Window[mode="maximized"] #btnStandard, Window[mode="maximized"] #btnDetailed {
  font-size: 16px;
}

#borderAnalise {
  border-radius: 12px;
}

Window[mode="maximized"] #borderAnalise {
  border-radius: 15px;
}

#borderAnalise

#indicatorAnalise {
  background-color: #62F59F;
}

QComboBox {
  background-color: transparent;
  border-radius: 5px;
  font-size: 14px;
  padding: 8px;
}

#btnComma, #btnPoint {
  font-size: 12px;
  border-radius: 15px;
  padding: 6px;
}

Window[mode="maximized"] #btnComma, Window[mode="maximized"] #btnPoint {
  font-size: 16px;
  padding: 8px;
}

#btnBack {
  font-size: 14px;
  border-radius: 17px;
}

#settingsDiv {
  margin-left: 150px;
  margin-right: 150px;
}

/*Estilos da loading*/
#loadingTitle {
  margin-bottom: 10px;
  font-size: 18px;
}

QLabel#imgStatus[img="error"] {
  qproperty-pixmap: url("assets/images/x-circle.svg")
}

#progressBar {
  background-color: #7E7E7E;
  border-radius: 4px;
}

#stepsContainer {
  margin-top: 10px;
}

#stepLabel {
  font-size: 18px;
}