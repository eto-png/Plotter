QLabel {
  font-family: 'Poppins', sans-serif;
}

#titulo {
  color: #FFFFFF;
  font-size: 22px;
  margin-left: 12px;
}
            
#btnMin, #btnWid, #btnClose, #btnMenu {
  background-color: #070C27;
  color: #ACABAB;
  border: none;
}

#btnMenu {
  border-radius: 8px;
}
            
#btnMin:hover, #btnWid:hover, #btnMenu:hover {
  background-color: #b4befe;
}

#btnClose:hover {
  background-color: #b53836;
}

#btnMin:pressed, #btnWid:pressed, #btnClose:pressed {
  background-color: #74c7ec;
}

#barraTitulo {
  background-color: #070C27;
}

#btnMin {
  padding-bottom: 10px;
}


#conteudo QLabel {
  color: #ACABAB;
}

#linha {
  background-color: #D9D9D9;
}

#labelTitulo {
  font-size: 58px;
  margin-bottom: 2px;
}

#labelTexto {
  font-size: 22px;
  margin-top: 11px;
  margin-bottom: 150px;
}

#btnUpload {
  background-color: transparent;
  border: 3px solid #ACABAB;
  border-radius: 20px;
}

#btnUpload:hover {
  border-color: #636262;
}

#sidebar {
  background-color: #801A1C2A;
}

#btnConfig, #btnHistory {
  text-align: left;
  background-color: transparent;
  color: #FFFFFF;
  font-family: 'Poppins', sans-serif;
  font-size: 14px;
}

#btnConfig:hover, #btnHistory:hover {
  color: #8C8A8A;
}

#btnCloseSidebar {
  background-color: transparent;
  border-radius: 20px;
  border: none;
}

#btnCloseSidebar:hover {
  background-color: #338C8A8A;
}

#menuRow {
  background-color: #807E7E7E;
}

#settingsDiv {
  background-color: #1A1C2A;
}

#cardSettings {
  background-color: #222538;
}

#cardTitle, #cardDesc {
  font-size: 16px;
}

#cardDesc {
  font-weight: bold;
}

#btnDark, #btnLight, #btnSystem {
  background-color: transparent;
  border: 1px solid #D9D9D9;
  border-radius: 5px;
  color: #D9D9D9;
  font-size: 16px;
  padding: 8px;
}

#btnDark:hover, #btnLight:hover, #btnSystem:hover, #btnDark:checked, #btnLight:checked, #btnSystem:checked {
  border-color: #62F59F;
  color: #62F59F;
}

#borderAnalise {
  border: 1px solid #62F59F;
  border-radius: 15px;
}

#indicatorAnalise {
  background-color: #62F59F;
}

QComboBox {
  background-color: transparent;
  border: 1px solid #62F59F;
  border-radius: 5px;
  color: #D9D9D9;
  font-size: 14px;
  padding: 10px;
}

#settingsTitle {
  font-size: 24px;
}

QLabel#settingsTitle {
  color: #D9D9D9;
}

#btnComma, #btnPoint {
  background-color: transparent;
  border: 1px solid #62F59F;
  color: #FFFFFF;
  font-size: 16px;
  border-radius: 10px;
  padding: 8px;
}

#btnComma:hover, #btnPoint:hover, #btnComma:checked, #btnPoint:checked {
  background-color: #62F59F;
  color: #000000;
}

#btnBack {
  background-color: #62F59F;
  color: #000000;
  font-size: 14px;
  border-radius: 20px;
}